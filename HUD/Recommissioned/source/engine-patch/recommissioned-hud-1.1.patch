+            filled(pen, relative(r, -29, 7, 1, 12, 142, 38), .{ 1, 0.55, 0.05, 1 });
+            filled(pen, relative(r, -45, 12, 32, 1, 142, 38), .{ 1, 0.55, 0.05, 1 });
