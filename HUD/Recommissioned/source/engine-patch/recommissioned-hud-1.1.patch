+        try text(pen, pen.strings.string(shown.pilot orelse 0) orelse "", r, @floatFromInt(height), .left);
+        r.y += pitch;
+        try text(pen, hud.rangeText(buffer[0..16], shown.facts.range), r, @floatFromInt(height), .left);
+        r.y += pitch;
