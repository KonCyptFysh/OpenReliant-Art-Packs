* text=auto
*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.js text eol=lf
*.html text eol=lf
*.css text eol=lf
*.yml text eol=lf
*.ini text eol=lf
*.png filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.shp filter=lfs diff=lfs merge=lfs -text
*.SHP filter=lfs diff=lfs merge=lfs -text
# Runtime HUD films and fonts.
*.fm8 filter=lfs diff=lfs merge=lfs -text
*.ttf filter=lfs diff=lfs merge=lfs -text
# GitHub Pages serves small web previews as real files, never LFS pointers.
docs/** -filter !diff !merge

# Preserve every frozen HUD runtime byte so manifest hashes survive checkout.
HUD/Recommissioned/** -text

HUD/Recommissioned/**/*.FM8 filter=lfs diff=lfs merge=lfs -text

# Preserve existing legacy runtime/test pointer representation until those packages are revised.
*.dte filter=lfs diff=lfs merge=lfs -text
*.ut filter=lfs diff=lfs merge=lfs -text
