#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
refs_file=$(mktemp)
trap 'rm -f "$refs_file"' EXIT HUP INT TERM
cat > "$refs_file"
while read -r local_ref local_oid remote_ref remote_oid; do
    case "$local_oid" in 0000000000000000000000000000000000000000) continue ;; esac
    python3 tools/release_policy.py --ref "$local_oid" --history
done < "$refs_file"
git lfs pre-push "$@" < "$refs_file"
