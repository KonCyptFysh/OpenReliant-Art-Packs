mission({name="Reliant - Worn Paint inspection"})
reliant=flight_group("(FG)Reliant", {wing="player"})
reliant_inspection=ship("Reliant - Inspection", {type="reliant", group=reliant})
initialise=part("(F)ReliantInspection", function()
 CreateFlightGroup(reliant)
 Wait(1)
 StartShipAnimation(reliant_inspection, "opendoor")
 StartShipAnimation(reliant_inspection, "opendoor2")
 Wait(1)
 StopShipAnimation(reliant_inspection, "opendoor")
 StopShipAnimation(reliant_inspection, "opendoor2")
 Wait(0)
 StartShipAnimationReverse(reliant_inspection, "opendoor")
 StartShipAnimationReverse(reliant_inspection, "opendoor2")
 Wait(1)
 StopShipAnimation(reliant_inspection, "opendoor")
 StopShipAnimation(reliant_inspection, "opendoor2")
 Wait(0)
 StartShipAnimation(reliant_inspection, "opendoor")
 StartShipAnimation(reliant_inspection, "opendoor2")
 Wait(1)
 StopShipAnimation(reliant_inspection, "opendoor")
 StopShipAnimation(reliant_inspection, "opendoor2")
 return 1
end, {start=true})
